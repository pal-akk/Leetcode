class Solution {
public:
    int help(vector<int>& arr , int strt , int end) {
        int n = arr.size();
        int prev=0;
        int prev2=0;
        for(int i=strt ; i<=end ; i++){
            int notake= 0 + prev;
            int take=arr[i]+prev2;
            int curr=max(take,notake);
            prev2=prev;
            prev=curr;
        }
        return prev;
        
    }
    int rob(vector<int> &nums){
        int n=nums.size();
        if(n==1) return nums[0];
        if(n==2) return max(nums[0],nums[1]);
        int c1=help(nums,0,n-2);
        int c2=help(nums,1,n-1);
        return max(c1,c2);
    }
};
