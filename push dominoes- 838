class Solution {
public:
    string pushDominoes(string dominoes) {
        int n= dominoes.size();
        int prev=-1;
        for(int i=0 ; i<n ; i++){
            if(prev==-1){
                if(dominoes[i]=='L'){
                    for(int j=0 ; j<i ; j++){
                        dominoes[j]='L';
                    }
                }
            }
            else if(dominoes[prev]=='R' && dominoes[i]=='R'){
                for(int j= prev+1 ; j<i ; j++){
                    dominoes[j]='R';
                }
            }
            else if(dominoes[prev]=='L' && dominoes[i]=='L'){
                for(int j=prev+1 ; j<i ; j++){
                    dominoes[j]='L';
                }
            }
            else if(dominoes[prev]=='R' && dominoes[i]=='L'){
                int a=prev+1;
                int b=i-1;
                while(a<b){
                    dominoes[a++]='R';
                    dominoes[b--]='L';
                }
            }
            if(dominoes[i]=='R' || dominoes[i]=='L'){
                prev=i;
            }
        }
        if(prev!=-1 && prev<n && dominoes[prev]=='R'){
            while(prev<n){
                dominoes[prev]='R';
                prev++;
            }
        }
        return dominoes;
        
    }
};
