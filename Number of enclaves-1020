class Solution {
public:
    void dfs(int row , int col , int dr[] , int dc[] , vector<vector<int>> &vis, vector<vector<int>> &grid){
        vis[row][col]=1;
        int n= grid.size();
        int m=grid[0].size();
        for(int i=0 ; i<4 ; i++){
            int r=row+dr[i];
            int c=col+dc[i];
            if(r>=0 && r<n && c>=0 && c<m && !vis[r][c] && grid[r][c]==1){
                dfs(r,c,dr,dc,vis,grid);
            }
        }
    }
    int numEnclaves(vector<vector<int>>& grid) {
        int n= grid.size();
        int m= grid[0].size();
        int dr[] = {0,1,-1,0};
        int dc[] = {1,0,0,-1};
        vector<vector<int>> vis(n,vector<int>(m,0));
        for(int j=0 ; j<m ; j++){
            if(!vis[0][j] && grid[0][j]==1){
                dfs(0,j,dr,dc,vis,grid);
            }
            if(!vis[n-1][j] && grid[n-1][j]==1){
                dfs(n-1,j,dr,dc,vis,grid);
            }
        }
        for(int i=0 ; i<n ; i++){
            if(!vis[i][0] && grid[i][0]==1){
                dfs(i,0,dr,dc,vis,grid);
            }
            if(!vis[i][m-1] && grid[i][m-1]==1){
                dfs(i,m-1,dr,dc,vis,grid);
            }
        }
        int cnt=0;
        for(int i=0 ; i<n ; i++){
            for(int j=0 ; j<m ; j++){
                if(!vis[i][j] && grid[i][j]==1){
                    cnt++;
                }
            }
        }
        return cnt;
        
        
    }
};
