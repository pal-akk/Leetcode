class Solution {
public:
    int longestConsecutive(vector<int>& nums) {
        int n = nums.size();
        if(n==0) return 0;
        sort(nums.begin(),nums.end());
        int l=0 ;
        int r= n-1;
        int msize=1;
        int size=1;
        while(l<r){
            if(nums[l+1]-nums[l]==1){
                size+=1;
                msize=max(msize,size);
            }
            else if(nums[l]==nums[l+1]){ 
            } 
            else{
                size=1;
            }
            l++;
        }
        return msize;
        
    }
};
