class Solution {
public:
    void bfs(int r , int c , vector<vector<char>> &grid , vector<vector<int>> &vis){
        vis[r][c]=1;
        queue<pair<int,int>> q;
        int n = grid.size();
        int m = grid[0].size();
        int delr[]={-1,1,0,0};
        int delc[]={0,0,1,-1};
        q.push({r,c});
        while(!q.empty()){
            int row=q.front().first;
            int col=q.front().second;
            q.pop();
            for(int i=0 ; i<4 ; i++){
                int nr=delr[i]+row;
                int nc=delc[i]+col;
                if(nr>=0 && nr<n && nc>=0 && nc<m && vis[nr][nc]!=1 && grid[nr][nc]=='1'){
                    vis[nr][nc]=1;
                    q.push({nr,nc});
                    
                }
            }
        }
    }
    int numIslands(vector<vector<char>>& grid) {
        int n=grid.size();
        int m=grid[0].size();
        int cnt=0;
        vector<vector<int>> vis(n,vector<int>(m,0));
        for(int i=0 ; i<n ;i++){
            for(int j=0 ; j<m ; j++){
                if(vis[i][j]!=1 && grid[i][j]=='1'){
                    bfs(i,j,grid,vis);
                    cnt++;
                }
            }
        }
        return cnt;
        
    }
};
