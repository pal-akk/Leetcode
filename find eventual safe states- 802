class Solution {
public:
    bool dfs(int j , vector<int> &vis , vector<int> &path , vector<int> &check , vector<vector<int>> &graph){
        vis[j]=1;
        path[j]=1;
        for(auto i : graph[j]){
            if(!vis[i]){
                if(dfs(i,vis,path,check,graph)==true){
                    check[i]=0;
                    return true;
                }
            }
            else if(path[i]==1){
                check[i]=0;
                return true;
                
            }
        }
        check[j]=1;
        path[j]=0;
        return false;

    }
    vector<int> eventualSafeNodes(vector<vector<int>>& graph) {
        int v=graph.size();
        vector<int> vis(v,0);
        vector<int> path(v,0);
        vector<int> check(v,0);
        vector<int> ans;
        for(int i=0 ; i<v ; i++){
            if(!vis[i]){
                dfs(i,vis,path,check,graph);
            }
        }
        for(int i=0 ; i<v ; i++){
            if(check[i]==1){
                ans.push_back(i);
            }

        }
        return ans;
        
    }
};
