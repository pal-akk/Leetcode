class Solution {
public:
    vector<vector<string>> groupAnagrams(vector<string>& strs) {
        int n=strs.size();
        vector<vector<string>> ans;
        unordered_map<string , vector<string>> check;
        for(int i=0 ; i<n ; i++){
            string a=strs[i];
            sort(a.begin(),a.end());
            check[a].push_back(strs[i]);
        }
        for(auto p : check){
            ans.push_back(p.second);
        }
        return ans;

        
    }
};
