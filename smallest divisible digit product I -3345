class Solution {
public:
    int smallestNumber(int n, int t) {
        int res=n;
        for(int i=0 ; i<t ; i++){
            res=n+i;
            int num = res;
            int p=1;
            while(num>0){
                p*=num%10;
                num=num/10;
            }
            if(p%t==0){
                break;
            } 
        }
        return res;
        
    }
};
