class Solution {
public:
    int orangesRotting(vector<vector<int>>& grid) {
        int n=grid.size();
        int m=grid[0].size();
        int vis[n][m];
        int tym=0;
        int fresh=0;
        int cnt=0;
        queue<pair<pair<int,int>,int>> q;
        for(int i=0 ; i<n ; i++){
            for(int j=0 ; j<m ; j++){
                if(grid[i][j]==2){
                    q.push({{i,j},0});

                }
                else if(grid[i][j]==1){
                    vis[i][j]=1;
                    fresh++;
                }
                else{
                    vis[i][j]=0;
                }
            }
        }
        int dlr[]={1,0,-1,0};
        int dlc[]={0,-1,0,1};
        while(!q.empty()){
            int r=q.front().first.first;
            int c=q.front().first.second;
            int t=q.front().second;
            tym=max(tym,t);
            q.pop();
            for(int i=0 ; i<4 ; i++){
                int row=r+dlr[i];
                int col=c+dlc[i];
                if(row>=0 && row<n && col>=0 && col<m && grid[row][col]==1 && vis[row][col]==1){
                    q.push({{row,col},t+1});
                    vis[row][col]=2;
                    cnt++;
                }
            }
        }
        if(cnt!=fresh){
            return -1;
        }
        return tym;
        
    }
};
