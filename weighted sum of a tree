class Solution {
public:
    long long weightedSum(vector<int>& parent, vector<int>& nums) {
        int n= parent.size();
        vector<vector<int>> child(n);
        for(int i=1 ; i<n ;i++){
            child[parent[i]].push_back(i);
        }
        int h=1;
        vector<int> depth(n);
        depth[0]=1;
        queue<int> q;
        q.push(0);
        while(!q.empty()){
            int node=q.front();
            q.pop();
            for(int c : child[node]){
                depth[c]=depth[node]+1;
                h=max(h,depth[c]);
                q.push(c);
                
            }
        }

        long long ans=0;
        for(int i=0 ; i<n ; i++){
            ans+=1LL * nums[i] *(h-depth[i]+1);
        }
        return ans;
        
        
        
    }
};
