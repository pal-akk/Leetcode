class Solution {
public:
    bool checkValidString(string s) {
        int n=s.size();
        int low=0; // means lowest possible count that is not balanced
        int high=0; // highest possible count that is not balanced
        for(char c : s){
            if(c=='('){
                low++;
                high++;
            }
            else if(c==')'){
                low=max(0,low-1);
                high--;
            }
            else{
                low=max(0,low-1);
                high++;
            }
            if(high<0) return false;
        }
        return low==0;
        
    }
};
