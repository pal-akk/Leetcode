class Solution {
public:
    vector<int> validSequence(string word1, string word2) {
        int n = word1.size();
        int m = word2.size();
        vector<int> arr;
        vector<int> last(m,-1);
        int i=n-1;
        int j=m-1;
        while(i>=0 && j>=0){
            if(word1[i]==word2[j]){
                last[j]=i;
                j--;
            }
            i--;
        }

        i=0;
        j=0;
        bool can = true;
        while(i<n && j<m){
            if(word1[i]==word2[j]){
                arr.push_back(i);
                i++;
                j++;
            }
            else if(can && (j==m-1 || i<last[j+1])){
                arr.push_back(i);
                can=false;
                i++;
                j++;
            }
            else i++;
        }
        if(j==m) return arr;
        else return {};
        
    }
};
