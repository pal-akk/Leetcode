class Solution {
public:
    string dig(string s , int k){
        string ans="";
        for(int i=0 ; i<s.size() ; i+=k){
            string s1=s.substr(i,k);
            int n=0;
            for(char c: s1){
                n+=c-'0';
            }
            ans+=to_string(n);
        }
        return ans;

    }
    string digitSum(string s, int k) {
        while(s.size()>k){
            s=dig(s,k);
        }
        return s;
        
    }
};
